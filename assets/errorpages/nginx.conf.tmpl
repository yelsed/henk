{{HENK_FILE_HEADER}}
# Generated by `henk` — hand-edits will be overwritten on `henk up`.
#
# Serves henk's error pages. Which page, and in which format, is decided here —
# nginx is the only place that can see both the request path and the client's
# Accept header.
#
# Three callers land here:
#   - the `henk-errors` middleware, which fetches `/{status}.html` after a
#     backend returns a 5xx;
#   - the per-project `failover` fallback, which forwards the visitor's
#     original path when the backend's health check says it's down;
#   - the `henk-catchall` router, whose `replacePath` sends unlinked hostnames
#     to `/unlinked`.
# Every one of them must get a real error status — a 200 here would tell the
# browser (and any script) that a dead app is fine.

# Browsers ask for text/html; curl, fetch and coding agents send `*/*` and get
# prose they can actually read instead of a document full of markup.
map $http_accept $henk_ext {
    default          txt;
    "~*text/html"    html;
    ""               html;
}

map $request_uri $henk_body {
    default              down;
    "~^/unlinked$"       unlinked;
    # Traefik answers 502 when it cannot connect and 504 when the backend times
    # out — both mean "not answering". A 500 comes from an app that did answer.
    # A dockerised project behind its own nginx can blur this; the split is a
    # heuristic, not a guarantee.
    "~^/50[234]\.html$"  down;
    "~^/5\d\d\.html$"    app-error;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;

    # No `=` before the target: nginx keeps the original status.
    error_page 404 500 501 502 503 504 505 /henk-page;

    location = /henk-page {
        internal;
        add_header Vary Accept always;
        try_files /$henk_body.$henk_ext =503;
    }

    location = /unlinked {
        return 404;
    }

    location / {
        return 503;
    }
}
