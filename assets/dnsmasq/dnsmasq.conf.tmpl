{{HENK_FILE_HEADER}}
# Generated by `henk` — hand-edits will be overwritten on `henk update`.
#
# Drop-in for Homebrew dnsmasq's `dnsmasq.d/`. Tells the running dnsmasq
# to resolve every name under `.{{TLD}}` (and any subdomain depth) to
# 127.0.0.1, which is where the henk Traefik container binds :80 / :443.
#
# This file is NOT a full dnsmasq config. The main `dnsmasq.conf` (the one
# Homebrew ships) loads it via `conf-dir=/opt/homebrew/etc/dnsmasq.d,*.conf`.
# We deliberately ship only the address directive so we coexist cleanly
# with other tools (Valet, DDEV, …) that may also drop files into the
# same directory.

address=/.{{TLD}}/127.0.0.1
