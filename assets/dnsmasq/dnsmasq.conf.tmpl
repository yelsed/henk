{{HENK_FILE_HEADER}}
# Generated by `henk` — hand-edits will be overwritten on `henk update`.

# Listen on all interfaces inside the container; the host only reaches us
# via the published 127.0.0.1:{{DNSMASQ_PORT}} port mapping.
listen-address=0.0.0.0
port=53

# Resolve every name under .{{TLD}} to 127.0.0.1, regardless of subdomain
# depth. Traefik (host :80 / :443) takes it from there.
address=/.{{TLD}}/127.0.0.1

# Don't read the host's /etc/resolv.conf; we only answer the .{{TLD}} zone.
no-resolv

# Don't read /etc/hosts inside the container (irrelevant — wouldn't help).
no-hosts

# Be quiet. Set log-queries here to debug.
quiet-dhcp
quiet-ra
