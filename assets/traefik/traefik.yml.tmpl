{{HENK_FILE_HEADER}}
# Generated by `henk` — hand-edits will be overwritten on `henk update`.

api:
  dashboard: true
  insecure: false

entryPoints:
  web:
    address: ":80"
  websecure:
    address: ":443"

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: henk-proxy
  # file provider is wired up in M3 once dynamic.yml carries TLS / host-mode
  # entries. Adding it before that confuses Traefik with empty config.

log:
  level: WARN

accessLog: {}
