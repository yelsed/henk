{{HENK_FILE_HEADER}}
# Generated by `henk` — hand-edits will be overwritten on `henk update`.
#
# File-provider config. Carries:
#   - The wildcard cert for *.<tld> issued by mkcert (M3).
#   - Host-mode routers/services for projects without a compose file (M6).

tls:
  stores:
    default:
      defaultCertificate:
        certFile: /certs/_wildcard.{{TLD}}.pem
        keyFile: /certs/_wildcard.{{TLD}}-key.pem
  certificates:
    - certFile: /certs/_wildcard.{{TLD}}.pem
      keyFile: /certs/_wildcard.{{TLD}}-key.pem
      stores:
        - default
