{{HENK_FILE_HEADER}}
# Generated by `henk` — hand-edits will be overwritten on `henk update`.
# See docs/customization.md for safe extension points.

services:
  traefik:
    image: traefik:v3.2
    container_name: henk-traefik
    restart: unless-stopped
    ports:
      - "{{HTTP_PORT}}:80"
      - "{{HTTPS_PORT}}:443"
      - "127.0.0.1:{{DASHBOARD_PORT}}:8080"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik.yml:/etc/traefik/traefik.yml:ro
      - ./dynamic.yml:/etc/traefik/dynamic.yml:ro
    networks:
      - henk-proxy
    labels:
      - traefik.enable=true
      - traefik.http.routers.henk-dashboard.rule=Host(`traefik.localhost`)
      - traefik.http.routers.henk-dashboard.entrypoints=web
      - traefik.http.routers.henk-dashboard.service=api@internal

networks:
  henk-proxy:
    external: true
    name: henk-proxy
