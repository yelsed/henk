{{HENK_FILE_HEADER}}
# Generated by `henk` — hand-edits will be overwritten on `henk update`.
# See docs/customization.md for safe extension points.

services:
  traefik:
    image: traefik:v3.5
    container_name: henk-traefik
    restart: unless-stopped
    ports:
      - "{{HTTP_PORT}}:80"
      - "{{HTTPS_PORT}}:443"
      - "127.0.0.1:{{DASHBOARD_PORT}}:8080"
    volumes:
      - ./traefik.yml:/etc/traefik/traefik.yml:ro
      # Mount the *whole* dynamic dir so per-project YAMLs (`<slug>.yml`)
      # are picked up by Traefik's file provider in `directory:` mode.
      - ../dynamic:/etc/traefik/dynamic:ro
      - ./certs:/certs:ro
    networks:
      - henk-proxy

  # NOTE: dnsmasq is intentionally absent from this stack right now.
  # The plan called for it to live alongside Traefik in this compose file,
  # but verification on Docker Desktop 4.71 / Docker Engine 29.4.1 / linuxkit
  # 6.12.76 showed that even peer-container DNS queries to a dnsmasq sidecar
  # never reach the dnsmasq process — the TCP connection is accepted, the
  # bind shows up in `ss` and `lsof`, but query packets are silently dropped
  # by the bridge network. Both alpine+apk and 4km3/dnsmasq:2.90-r3 hit the
  # same wall.
  #
  # The pragmatic fix (M3.5) is to install dnsmasq via Homebrew on the host
  # and start it under launchd — same path Laravel Valet and DDEV take. This
  # adds one extra sudo prompt at init (needed to bind :53 on the host) but
  # gives us reliable DNS resolution for `*.<tld>`. Tracking in
  # docs/troubleshooting.md and to-do for M3.5.

networks:
  henk-proxy:
    external: true
    name: henk-proxy
